<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 8+ 自适应图标的背景层。
  和桌面图标同一个紫罗兰渐变，让启动器裁剪后仍是整块实色，
  不会像纯色那样在圆角处露出白边。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
  <gradient
      android:angle="315"
      android:startColor="#816AFF"
      android:endColor="#4E2FD6"
      android:type="linear" />
</shape>
