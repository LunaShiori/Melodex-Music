{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Melodex",
  "version": "1.0.1",
  "identifier": "app.melodex",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Melodex",
        "width": 1180,
        "height": 780,
        "minWidth": 880,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: http: asset: data: blob:; media-src 'self' https: http: asset: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' https: http: ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "多源音乐聚合搜索与下载",
    "longDescription": "Melodex 把网易云、QQ 音乐、酷我的搜索结果合并成一份列表，统一试听、批量下载与标签写入。",
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
