{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Melodex Music",
  "version": "2.1.0",
  "identifier": "app.melodex",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Melodex Music",
        "width": 1180,
        "height": 780,
        "minWidth": 880,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: http: asset: data: blob:; media-src 'self' https: http: asset: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' https: http: ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "多源音乐聚合搜索、播放与歌词",
    "longDescription": "Melodex Music 把网易云、QQ 音乐、酷我的搜索结果合并成一份列表，内置播放器与逐行歌词，支持账号歌单读取、批量下载与标签写入。",
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "mp3"
        ],
        "name": "MP3 audio",
        "description": "MP3 音频",
        "role": "Viewer",
        "mimeType": "audio/mpeg"
      },
      {
        "ext": [
          "flac"
        ],
        "name": "FLAC audio",
        "description": "FLAC 无损音频",
        "role": "Viewer",
        "mimeType": "audio/flac"
      },
      {
        "ext": [
          "m4a"
        ],
        "name": "M4A audio",
        "description": "M4A 音频",
        "role": "Viewer",
        "mimeType": "audio/mp4"
      },
      {
        "ext": [
          "aac"
        ],
        "name": "AAC audio",
        "description": "AAC 音频",
        "role": "Viewer",
        "mimeType": "audio/aac"
      },
      {
        "ext": [
          "wav"
        ],
        "name": "WAV audio",
        "description": "WAV 音频",
        "role": "Viewer",
        "mimeType": "audio/wav"
      },
      {
        "ext": [
          "ogg",
          "opus"
        ],
        "name": "OGG audio",
        "description": "OGG / Opus 音频",
        "role": "Viewer",
        "mimeType": "audio/ogg"
      }
    ]
  }
}
